<xsl:stylesheet version="3.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:fo="http://www.w3.org/1999/XSL/Format"><xsl:output method="xml"/><xsl:template match="/"><fo:root><fo:layout-master-set><fo:simple-page-master master-name="page" page-height="11in" page-width="8.5in" margin="0.7in"><fo:region-body/></fo:simple-page-master></fo:layout-master-set><fo:page-sequence master-reference="page"><fo:flow flow-name="xsl-region-body"><fo:block font-size="24pt" color="#1f6f8b">Invoice <xsl:value-of select="/data/Invoice/Number"/></fo:block><fo:block><xsl:value-of select="/data/Firm/Name"/></fo:block><fo:block>Prepared for <xsl:value-of select="/data/Person/Name"/></fo:block><fo:block>Date: <xsl:value-of select="/data/Invoice/Date"/></fo:block><xsl:for-each select="/data/LineItems"><fo:block><xsl:value-of select="Description"/> — <xsl:value-of select="Quantity"/> × $<xsl:value-of select="format-number(Price,'0.00')"/></fo:block></xsl:for-each><fo:block font-weight="bold">Total: $<xsl:value-of select="format-number(/data/Invoice/Total,'#,##0.00')"/></fo:block><xsl:if test="/data/Person/Notes != ''"><fo:block><xsl:value-of select="/data/Person/Notes"/></fo:block></xsl:if></fo:flow></fo:page-sequence></fo:root></xsl:template></xsl:stylesheet>