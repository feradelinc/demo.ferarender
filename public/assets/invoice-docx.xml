<file name="document.xml" folder="word" transform="true"><xsl:stylesheet version="3.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><xsl:output method="xml" omit-xml-declaration="yes"/><xsl:template match="/"><w:document><w:body><w:p><w:r><w:t>Northstar Studio — Invoice</w:t></w:r></w:p><w:p><w:r><w:t><xsl:value-of select="/data/Firm/Name"/></w:t></w:r></w:p><w:p><w:r><w:t>Customer: <xsl:value-of select="/data/Person/Name"/></w:t></w:r></w:p><w:p><w:r><w:t>Invoice <xsl:value-of select="/data/Invoice/Number"/> — <xsl:value-of select="format-date(xs:date(/data/Invoice/Date),'[MNn] [D], [Y]')" xmlns:xs="http://www.w3.org/2001/XMLSchema"/></w:t></w:r></w:p><w:tbl><w:tblPr><w:tblW w:w="9000" w:type="dxa"/></w:tblPr><w:tblGrid><w:gridCol w:w="4500"/><w:gridCol w:w="4500"/></w:tblGrid><w:tr><w:tc><w:p><w:r><w:t>Description</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>Amount</w:t></w:r></w:p></w:tc></w:tr><xsl:for-each select="/data/LineItems"><w:tr><w:tc><w:p><w:r><w:t><xsl:value-of select="Description"/></w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>$<xsl:value-of select="format-number(Quantity * Price,'#,##0.00')"/></w:t></w:r></w:p></w:tc></w:tr></xsl:for-each></w:tbl><w:p><w:r><w:t>Total: $<xsl:value-of select="format-number(/data/Invoice/Total,'#,##0.00')"/></w:t></w:r></w:p><xsl:if test="/data/Person/Notes != ''"><w:p><w:r><w:t><xsl:value-of select="/data/Person/Notes"/></w:t></w:r></w:p></xsl:if><w:sectPr><w:pgSz w:w="12240" w:h="15840"/><w:pgMar w:top="1080" w:right="1080" w:bottom="1080" w:left="1080"/></w:sectPr></w:body></w:document></xsl:template></xsl:stylesheet></file>
