diff --git a/test/xslt-text-serialization.test.js b/test/xslt-text-serialization.test.js
new file mode 100644
--- /dev/null
+++ b/test/xslt-text-serialization.test.js
@@ -0,0 +1,20 @@
+const test = require("node:test");
+const assert = require("node:assert/strict");
+const fs = require("node:fs");
+const path = require("node:path");
+const sax = require("../support/xslt/SaxonJS2N");
+
+test("serialized text output preserves JSON mapping values containing XML-sensitive characters", () => {
+    const xsl = '<xsl:stylesheet version="3.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:fn="http://www.w3.org/2005/xpath-functions"><xsl:output method="text"/><xsl:template match="/"><xsl:variable name="fields"><fn:map><fn:string key="Customer name"><xsl:value-of select="/data/name"/></fn:string></fn:map></xsl:variable><xsl:value-of select="fn:xml-to-json($fields/*)"/></xsl:template></xsl:stylesheet>';
+    const doc = sax.getPlatform().parseXmlFromString(xsl);
+    doc._saxonBaseUri = "file:///";
+    const options = { stylesheetInternal: sax.compile(doc), sourceText: '<data><name>A &amp; B &lt;C&gt; "quoted" \\ path\nUnicode 🙂</name></data>' };
+    // Regression: serializing a result tree with toString() escapes JSON text as XML.
+    assert.notEqual(JSON.parse(sax.transform(options).principalResult.toString())["Customer name"], 'A & B <C> "quoted" \\ path\nUnicode 🙂');
+    const actual = sax.transform({ ...options, destination: "serialized" }).principalResult;
+    assert.equal(JSON.parse(actual)["Customer name"], 'A & B <C> "quoted" \\ path\nUnicode 🙂');
+    for (const file of ["routes/api/v1/pdf.forms/service.js", "routes/api/v1/xml/service.js"]) {
+        const source = fs.readFileSync(path.join(__dirname, "..", file), "utf8");
+        assert.match(source, /destination:\s*"serialized"/);
+    }
+});
